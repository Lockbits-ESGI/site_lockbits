RewriteEngine On

# Route /metrics → metrics.php (endpoint Prometheus)
# Doit être AVANT les règles client pour éviter la redirection 301
RewriteRule ^metrics$ metrics.php [L]

# Trust HTTPS when behind a reverse proxy (preprod/prod)
SetEnvIf X-Forwarded-Proto "https" HTTPS=on

# -----------------------------------------------------------
# Clean URLs — masquer les extensions .php
# -----------------------------------------------------------
# Redirige /client/xxx.php -> /client/xxx (301, préserve query string)
RewriteCond %{THE_REQUEST} \s/(client/[a-zA-Z_-]+)\.php[?\s] [NC]
RewriteRule ^ /%1 [R=301,L,QSA]

# Réécriture interne : /client/xxx -> /client/xxx.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^client/([a-zA-Z_-]+)$ client/$1.php [L]
